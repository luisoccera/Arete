{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Arete: servidor local",
      "program": "${workspaceFolder}/backend/src/index.js",
      "cwd": "${workspaceFolder}",
      "env": {
        "PORT": "3001"
      },
      "console": "integratedTerminal",
      "serverReadyAction": {
        "pattern": "activo en (http://localhost:\\d+)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    }
  ]
}
