# local: sin cuenta; los expedientes permanecen en el navegador/dispositivo.
# cloud: exige cuenta y guarda estados por usuario en ARETE_DATA_DIR.
ARETE_DEPLOYMENT_MODE=local
ARETE_DATA_DIR=./backend/data
ARETE_EXPOSE_RECOVERY_CODE=false

PORT=3001

# Appwrite se configura en frontend/assets/js/config/runtime-config.js y
# apps/arete-native/.env. Estos identificadores son públicos; nunca agregues
# una API key administrativa al frontend.
APPWRITE_ENDPOINT=https://<REGION>.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_DATABASE_ID=
APPWRITE_STATE_TABLE_ID=arete_state
